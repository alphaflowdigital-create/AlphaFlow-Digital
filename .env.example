# ─────────────────────────────────────────────────────────────
# AlphaFlow Digital — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# ─────────────────────────────────────────────────────────────

# URL pública do site (sem barra no final). Usada em SEO, sitemap, canonical e e-mails.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# WhatsApp comercial — somente números, com DDI + DDD. Ex.: 5519999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Perfil do Instagram (URL completa)
NEXT_PUBLIC_INSTAGRAM_URL=

# E-mail público de contato (opcional — exibido no rodapé e na política de privacidade)
NEXT_PUBLIC_CONTACT_EMAIL=

# Dados do negócio local (opcionais — só aparecem no Schema.org/rodapé se preenchidos)
NEXT_PUBLIC_BUSINESS_CITY=
NEXT_PUBLIC_BUSINESS_STATE=
NEXT_PUBLIC_BUSINESS_STREET=
NEXT_PUBLIC_BUSINESS_POSTAL_CODE=
NEXT_PUBLIC_BUSINESS_CNPJ=

# Google Analytics 4 (ex.: G-XXXXXXXXXX). Só carrega após consentimento de cookies.
NEXT_PUBLIC_GA_ID=

# ── Supabase (autenticação, área do cliente e armazenamento dos orçamentos) ──
# Painel Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta — NUNCA exponha no navegador. Usada apenas no servidor para gravar orçamentos.
SUPABASE_SERVICE_ROLE_KEY=

# ── Notificação de novos orçamentos (opcional) ──
# Opção A: e-mail via Resend (https://resend.com)
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=
LEADS_FROM_EMAIL=AlphaFlow Digital <onboarding@resend.dev>
# Opção B: webhook (Make, Zapier, n8n, Discord, etc.) — recebe o JSON do orçamento via POST
LEADS_WEBHOOK_URL=
